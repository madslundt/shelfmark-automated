# ── Required ─────────────────────────────────────────────────────────────────
# Hardcover Bearer token (Settings → Hardcover API)
HARDCOVER_API_KEY=

# Goodreads RSS URL for your shelves
GOODREADS_RSS_URL=https://www.goodreads.com/review/list_rss/106824943

# ── CWA (Calibre-Web Automated) ───────────────────────────────────────────────
CWA_URL=http://homeassistant.local:8083
# Leave blank if CWA allows unauthenticated OPDS access
CWA_USERNAME=
CWA_PASSWORD=

# ── Shelfmark ─────────────────────────────────────────────────────────────────
SHELFMARK_URL=http://homeassistant.local:8084
# Leave blank if Shelfmark is configured with AUTH_METHOD=none
SHELFMARK_USERNAME=
SHELFMARK_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
HARDCOVER_USER_ID=
# How often to sync (seconds). Set to 0 to run once and exit (useful for testing).
SYNC_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
